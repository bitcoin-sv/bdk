# clang-tidy configuration for BDK's first-party C++ (core/, module/, test/).
#
# CI runs this with LLVM 23 (job `clang-tidy` in .github/workflows/build_bdk.yaml).
# Locally: cmake -S . -B ../build -DCMAKE_CXX_COMPILER=clang++-23 -DBDK_ENABLE_CLANG_TIDY=ON
# The CMake option also passes --header-filter/--exclude-header-filter as absolute
# paths, which is why no HeaderFilterRegex lives here: BSV_ROOT can be anywhere.
# bitcoin-sv, secp256k1, univalue, leveldb, generated sources and the upstream-derived
# files listed in BDK_UPSTREAM_DERIVED_SOURCES (cmake/BDKBuildSetting.cmake) are never linted.
#
# WarningsAsErrors: '*' turns every finding into a build failure. Suppress one line
# with `// NOLINT(check-name)` and a short reason; never disable a check for a file.
Checks: >
  -*,

  bugprone-*,

  clang-analyzer-*,

  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-*,
  -cppcoreguidelines-pro-type-*,

  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,

  modernize-*,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,

  -modernize-avoid-c-style-cast,
  -modernize-raw-string-literal,
  -modernize-use-auto,
  -modernize-use-integer-sign-comparison,
  -modernize-use-string-view,
  -modernize-use-transparent-functors,

  performance-*,
  -performance-enum-size,

  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-misleading-indentation,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,

WarningsAsErrors: '*'
FormatStyle: none
CheckOptions:
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
